#: PrimaryScreen.qml:769
#, kde-format
msgid "Keyboard layout"
msgstr "Распоред тастатуре"

#: PrimaryScreen.qml:814
#, kde-format
msgid "Desktop session"
msgstr "Сесија површи"

#: PrimaryScreen.qml:841
#, kde-format
msgid "Suspend"
msgstr "Суспендуј"

#: PrimaryScreen.qml:853
#, kde-format
msgid "Hibernate"
msgstr "У хибернацију"

#: PrimaryScreen.qml:866
#, kde-format
msgid "Restart"
msgstr "Поново покрени"

#: PrimaryScreen.qml:878
#, kde-format
msgid "Shutdown"
msgstr "Угаси"

#: PrimaryScreen.qml:908
#, kde-format
msgctxt "Button to show/hide virtual keyboard"
msgid "Virtual Keyboard"
msgstr "Виртуелна тастатура"
