#: accessibility.cpp:77
#, kde-format
msgid "Screen reading service failed to start."
msgstr "Не удалось запустить службу чтения с экрана."

#: accessibility.cpp:167
#, kde-format
msgid "Screen reading service not found."
msgstr "Служба чтения с экрана не найдена."

#: connectionsmodel.cpp:146
#, kde-format
msgid "VPN connection deactivated."
msgstr "VPN-подключение отключено."

#: connectionsmodel.cpp:148
#, kde-format
msgid ""
"VPN connection was deactivated because the device it was using was "
"disconnected."
msgstr ""
"VPN-подключение прервано, так как используемое для него устройство было "
"отключено."

#: connectionsmodel.cpp:150
#, kde-format
msgid "The service providing the VPN connection was stopped."
msgstr "Служба, обеспечивающая VPN-подключение, была остановлена."

#: connectionsmodel.cpp:152
#, kde-format
msgid "The IP config of the VPN connection was invalid."
msgstr "Неверная конфигурация IP для VPN-подключения."

#: connectionsmodel.cpp:154
#, kde-format
msgid "The connection attempt to the VPN service timed out."
msgstr "Истекло время ожидания подключения к службе VPN."

#: connectionsmodel.cpp:156
#, kde-format
msgid ""
"A timeout occurred while starting the service providing the VPN connection."
msgstr "Истекло время ожидания запуска службы, обеспечивающей VPN-подключение."

#: connectionsmodel.cpp:158
#, kde-format
msgid "Starting the service providing the VPN connection failed."
msgstr "Не удалось запустить службу, обеспечивающую VPN-подключение."

#: connectionsmodel.cpp:160
#, kde-format
msgid "Necessary secrets for the VPN connection were not provided."
msgstr "Пароли, необходимые для VPN-подключения, не были указаны."

#: connectionsmodel.cpp:162
#, kde-format
msgid "Authentication to the VPN server failed."
msgstr "Ошибка проверки подлинности на VPN-сервере."

#: connectionsmodel.cpp:164
#, kde-format
msgid "The connection was deleted."
msgstr "Подключение было удалено."

#: connectionsmodel.cpp:580
#, kde-format
msgid "No connection"
msgstr "Нет подключения"

