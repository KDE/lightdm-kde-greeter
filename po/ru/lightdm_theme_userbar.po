#: config.qml:37
#, kde-format
msgid "Background image:"
msgstr "Фоновое изображение:"

#: NetworkWidget.qml:24
#, kde-format
msgid "The connection will be active only on the login screen."
msgstr "Подключение будет активно только на экране входа в систему."

#: NetworkWidget.qml:61
#, kde-format
msgid "Disconnect from %1 ?"
msgstr "Отключиться от %1?"

#: NetworkWidget.qml:64
#, kde-format
msgid "Abort connecting to %1 ?"
msgstr "Прервать подключение к %1?"

#: NetworkWidget.qml:68
#, kde-format
msgid "Connect to %1 ?"
msgstr "Подключиться к %1?"

#: NetworkWidget.qml:72
#, kde-format
msgid "Connect to an insecure access point %1 ?"
msgstr "Подключиться к незащищённой точке доступа %1?"

#: NetworkWidget.qml:77
#, kde-format
msgid "Enter the password to connect to %1"
msgstr "Введите пароль для подключения к %1"

#: NetworkWidget.qml:82
#, kde-format
msgid "Enter login and password to connect to %1"
msgstr "Введите имя пользователя и пароль для подключения к %1"

#: NetworkWidget.qml:86 NetworkWidget.qml:92
#, kde-format
msgid "%1: Connection error, try again."
msgstr "%1: ошибка подключения, повторите попытку."

#: NetworkWidget.qml:97
#, kde-format
msgid "Provide the secrets to connect to %1:"
msgstr "Введите пароли для подключения к %1:"

#: NetworkWidget.qml:101
#, kde-format
msgid "The security protocol is not supported for %1"
msgstr "Протокол безопасности для %1 не поддерживается"

#: NetworkWidget.qml:104 NetworkWidget.qml:108
#, kde-format
msgid "Failed to connect to %1"
msgstr "Не удалось подключиться к %1"

#: NetworkWidget.qml:112
#, kde-format
msgid "Error: Can't find access point %1"
msgstr "Ошибка: не удалось найти точку доступа %1"

#: NetworkWidget.qml:440
#, kde-format
msgid "Login"
msgstr "Имя пользователя"

#: NetworkWidget.qml:455
#, kde-format
msgid "Password"
msgstr "Пароль"

#: NetworkWidget.qml:507
#, kde-format
msgid "Disable wireless"
msgstr "Отключить беспроводную сеть"

#: NetworkWidget.qml:507
#, kde-format
msgid "Enable wireless"
msgstr "Включить беспроводную сеть"

#: NetworkWidget.qml:508 NetworkWidget.qml:549
#, kde-format
msgid "Action prohibited"
msgstr "Действие запрещено"

#: NetworkWidget.qml:548
#, kde-format
msgid "Disable networking"
msgstr "Отключить сеть"

#: NetworkWidget.qml:548
#, kde-format
msgid "Enable networking"
msgstr "Включить сеть"

#: OtherScreen.qml:27
#, kde-format
msgid "Press %1 to change the primary screen"
msgstr "Нажмите %1, чтобы сменить основной экран"

#: PrimaryScreen.qml:56
#, kde-format
msgid "A fallback version of the login screen is running"
msgstr "Запущена резервная версия экрана входа в систему"

#: PrimaryScreen.qml:86
#, kde-format
msgid "Login failed"
msgstr "Не удалось выполнить вход"

#: PrimaryScreen.qml:538
#, kde-format
msgid "Caps Lock is on"
msgstr "Включён режим Caps Lock"

#: PrimaryScreen.qml:541
#, kde-format
msgid "Num Lock is on"
msgstr "Включён режим Num Lock"

#: PrimaryScreen.qml:544
#, kde-format
msgid "Caps Lock and Num Lock is on"
msgstr "Включены режимы Caps Lock и Num Lock"

#: PrimaryScreen.qml:557
#, kde-format
msgid "Log in"
msgstr "Войти"

#: PrimaryScreen.qml:576
#, kde-format
msgid "Log in as another user"
msgstr "Войти от имени другого пользователя"

#: PrimaryScreen.qml:769
#, kde-format
msgid "Keyboard layout"
msgstr "Раскладка клавиатуры"

#: PrimaryScreen.qml:814
#, kde-format
msgid "Desktop session"
msgstr "Графический сеанс"

#: PrimaryScreen.qml:841
#, kde-format
msgid "Suspend"
msgstr "Спящий режим"

#: PrimaryScreen.qml:853
#, kde-format
msgid "Hibernate"
msgstr "Гибернация"

#: PrimaryScreen.qml:866
#, kde-format
msgid "Restart"
msgstr "Перезагрузить"

#: PrimaryScreen.qml:878
#, kde-format
msgid "Shutdown"
msgstr "Выключить"

#: PrimaryScreen.qml:908
#, kde-format
msgctxt "Button to show/hide virtual keyboard"
msgid "Virtual Keyboard"
msgstr "Виртуальная клавиатура"
